# Copy this file to .env and fill in real values. Never commit .env.

# ShopBot GraphQL endpoint (the app must be running)
CHATBOT_GRAPHQL_URL=http://localhost:5173/graphql

# Old judge key (Groq). Not used any more; kept so you can switch the judge back.
GROQ_API_KEY=
# Judge LLM for DeepEval metrics: Gemini (free key from https://aistudio.google.com/apikey).
# A different model family and provider than ShopBot's own (openai/gpt-oss-20b on Groq).
JUDGE_API_KEY=
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_MODEL=gemini-3.8-flash
# To go back to Groq: JUDGE_API_KEY=<the Groq key>, JUDGE_BASE_URL=https://api.groq.com/openai/v1,
# JUDGE_MODEL=openai/gpt-oss-120b

# Free tiers have a requests/tokens-per-minute limit: retry rate-limit (429) errors for longer
DEEPEVAL_RETRY_MAX_ATTEMPTS=6
DEEPEVAL_RETRY_CAP_SECONDS=30
DEEPEVAL_TELEMETRY_OPT_OUT=YES
