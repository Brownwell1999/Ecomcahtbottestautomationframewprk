# Copy this file to .env and fill in real values. Never commit .env.

# ShopBot GraphQL endpoint (the app must be running)
CHATBOT_GRAPHQL_URL=http://localhost:5173/graphql

# Old judge key (Groq). Not used any more; kept so you can switch the judge back.
GROQ_API_KEY=
# Judge LLM for DeepEval metrics: Claude (key from https://console.anthropic.com/settings/keys).
# A different model family and provider than ShopBot's own (openai/gpt-oss-20b on Groq).
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-5-5

# LangSmith: where ShopBot records its conversation traces (key from https://smith.langchain.com).
# Used only by the online evaluation job (online_eval/), which reads traces and writes scores back.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopbot-dev

# Where ShopBot's own repo is on this machine. Used only by dataset_tools/ (knowledge base for synthetic
# goldens, database for thumbs-down feedback).
SHOPBOT_DIR=C:/Ecomchatboat

# Free tiers have a requests/tokens-per-minute limit: retry rate-limit (429) errors for longer
DEEPEVAL_RETRY_MAX_ATTEMPTS=6
DEEPEVAL_RETRY_CAP_SECONDS=30
DEEPEVAL_TELEMETRY_OPT_OUT=YES
